{
  "schemaVersion": 1,
  "id": "cosmeticsmod",
  "version": "${version}",
  "name": "Cosmetics Mod",
  "description": "Player cosmetics drawn through Minecraft's own entity render pipeline, built to coexist with Sodium, Iris and shaderpacks, LoD mods and other model mods.",
  "authors": ["Georgwav"],
  "contact": {
    "sources": "https://github.com/Georgwav/Cosmetics-Mod",
    "issues": "https://github.com/Georgwav/Cosmetics-Mod/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.georgwav.cosmetics.CosmeticsMod"],
    "modmenu": ["io.github.georgwav.cosmetics.compat.modmenu.ModMenuCompat"]
  },
  "mixins": ["cosmeticsmod.mixins.json"],
  "custom": {
    "cosmeticsmod:build": "${build}"
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  },
  "suggests": {
    "zoomify": "*",
    "freelook": "*",
    "mousetweaks": "*",
    "appleskin": "*",
    "shulkerboxtooltip": "*",
    "inventoryprofilesnext": "*",
    "chatpatches": "*",
    "chat_heads": "*",
    "nochatreports": "*",
    "screenshot_viewer": "*",
    "controlling": "*",
    "betterf3": "*",
    "xaerominimap": "*",
    "voicechat": "*",
    "modmenu": "*"
  }
}
