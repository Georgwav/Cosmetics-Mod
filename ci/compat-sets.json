{
  "_comment": "Mod stacks the compat job runs the game with. Mods are Modrinth project slugs; 'a|b' means the first one that has a build for that Minecraft version. Required dependencies are pulled in automatically. A stack is reported as 'n/a' for a Minecraft version when one of its mods has no build for it. 'env' adds environment variables to that stack's game (e.g. letting Mesa report OpenGL 4.6 for Voxy, which needs GLSL 4.60 while CI's software renderer reports 4.5). 'georg-pack' is the mod list of Georg's own 26.2 game (performance, Voxy, Punchy and the rest), so the jar he plays is tested as he plays it.",
  "sodium-iris-complementary": {
    "mods": [
      "sodium",
      "iris"
    ],
    "shaderpack": "complementary-reimagined"
  },
  "sodium-iris-bsl": {
    "mods": [
      "sodium",
      "iris"
    ],
    "shaderpack": "bsl-shaders"
  },
  "perf-stack": {
    "mods": [
      "sodium",
      "immediatelyfast",
      "entityculling"
    ]
  },
  "voxy": {
    "mods": [
      "sodium",
      "voxy"
    ],
    "env": {
      "MESA_GL_VERSION_OVERRIDE": "4.6",
      "MESA_GLSL_VERSION_OVERRIDE": "460"
    }
  },
  "distant-horizons": {
    "mods": [
      "distanthorizons"
    ]
  },
  "model-mods": {
    "mods": [
      "entity-model-features",
      "entitytexturefeatures",
      "3dskinlayers"
    ]
  },
  "figura": {
    "mods": [
      "figura|nofigura"
    ]
  },
  "modmenu": {
    "mods": [
      "modmenu"
    ]
  },
  "kept-hud": {
    "mods": [
      "appleskin",
      "xaeros-minimap",
      "jade",
      "simple-voice-chat"
    ]
  },
  "overlaps": {
    "mods": [
      "zoomify",
